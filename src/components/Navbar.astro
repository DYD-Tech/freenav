---
import { locales } from '../i18n/index';
---
<nav class="border-b border-border bg-surface/80 backdrop-blur-sm sticky top-0 z-50">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/freenav/" class="text-xl font-semibold text-primary-600 dark:text-primary-400" data-i18n="nav.home">FreeNav</a>
    <div class="flex items-center gap-4">
      <div class="relative" id="lang-switcher-container">
        <button id="lang-switch" class="p-2 rounded-lg hover:bg-muted flex items-center justify-center w-10 h-10 text-xl">
          🇺🇸
        </button>
        <div id="lang-dropdown" class="absolute right-0 top-full mt-1 hidden bg-surface border border-border rounded-lg shadow-lg py-1 min-w-[120px] z-50">
          {Object.entries(locales).map(([code, name]) => (
            <button
              class="lang-option flex items-center gap-2 px-3 py-2 text-sm hover:bg-muted w-full text-left"
              data-lang={code}
            >
              <span>{code === 'en' ? '🇺🇸' : code === 'zh' ? '🇨🇳' : code === 'ja' ? '🇯🇵' : code === 'ko' ? '🇰🇷' : code === 'es' ? '🇪🇸' : '🇫🇷'}</span>
              {name}
            </button>
          ))}
        </div>
      </div>
      <button id="theme-toggle" aria-label="Toggle dark mode" class="p-2 rounded-lg hover:bg-muted">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dark:hidden">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 9 9 0 0 0 21 12.79z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>
      <a href="/freenav/search" class="hidden sm:inline-flex items-center gap-2 px-3 py-2 text-sm rounded-lg border border-border hover:bg-muted" data-i18n="search">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        Search
      </a>
    </div>
  </div>
</nav>
<script>
  // Translation data for UI elements
  const translations = {
    en: { search: "Search", "nav.home": "FreeNav", "nav.about": "About", "nav.categories": "Categories", "nav.submit": "Submit", "nav.github": "GitHub", "footer.tagline": "All resources are curated and verified.", "search.placeholder": "Search free resources...", "hero.title": "Free Resources. Curated Daily.", "hero.subtitle": "Discover the best free resources — AI tools, design assets, dev tools, courses, and more. All free, all high-quality.", "sections.categories": "Categories", "sections.trending": "Trending This Week", "sections.recent": "Recently Added", "common.resources": "resources", noResources: "No resources found.", "backToHome": "← Back to home", "backToCategories": "← Back to all categories", noTrending: "No trending resources yet. Check back soon!", noRecent: "No resources yet. We're curating the best — check back daily!" },
    zh: { search: "搜索", "nav.home": "FreeNav", "nav.about": "关于", "nav.categories": "分类", "nav.submit": "提交", "nav.github": "GitHub", "footer.tagline": "所有资源均经筛选验证。", "search.placeholder": "搜索免费资源...", "hero.title": "免费资源。每日精选。", "hero.subtitle": "发现最佳免费资源 — AI 工具、设计素材、开发工具、课程等。全部免费，品质保证。", "sections.categories": "分类", "sections.trending": "本周热门", "sections.recent": "最近添加", "common.resources": "个资源", noResources: "暂无资源。", "backToHome": "← 返回首页", "backToCategories": "← 返回所有分类", noTrending: "暂无热门资源，敬请期待！", noRecent: "暂无资源，我们正在努力筛选中 — 每天回来看看！" },
    ja: { search: "検索", "nav.home": "FreeNav", "nav.about": "概要", "nav.categories": "カテゴリ", "nav.submit": "送信", "nav.github": "GitHub", "footer.tagline": "すべてのリソースは厳選・検証済みです。", "search.placeholder": "無料リソースを検索...", "hero.title": "無料リソース。毎日厳選。", "hero.subtitle": "最高の無料リソースを発見 — AIツール、デザインアセット、開発ツール、コースなど。すべて無料で、すべて高品質。", "sections.categories": "カテゴリ", "sections.trending": "今週のトレンド", "sections.recent": "最近追加", "common.resources": "リソース", noResources: "リソースはありません。", "backToHome": "← ホームへ戻る", "backToCategories": "← 全カテゴリへ戻る", noTrending: "今週のトレンドリソースはまだありません。", noRecent: "リソースはまだありません。" },
    ko: { search: "검색", "nav.home": "FreeNav", "nav.about": "정보", "nav.categories": "카테고리", "nav.submit": "제출", "nav.github": "GitHub", "footer.tagline": "모든 리소스는 엄선 및 검증되었습니다.", "search.placeholder": "무료 리소스 검색...", "hero.title": "무료 리소스. 매일 엄선.", "hero.subtitle": "최고의 무료 리소스를 발견하세요 — AI 도구, 디자인 에셋, 개발 도구, 강좌 등. 모두 무료, 모두 고품질.", "sections.categories": "카테고리", "sections.trending": "이번 주 트렌드", "sections.recent": "최근 추가", "common.resources": "리소스", noResources: "리소스가 없습니다.", "backToHome": "← 홈으로 돌아가기", "backToCategories": "← 모든 카테고리로 돌아가기", noTrending: "아직 트렌딩 리소스가 없습니다.", noRecent: "아직 리소스가 없습니다." },
    es: { search: "Buscar", "nav.home": "FreeNav", "nav.about": "Acerca de", "nav.categories": "Categorías", "nav.submit": "Enviar", "nav.github": "GitHub", "footer.tagline": "Todos los recursos son curados y verificados.", "search.placeholder": "Buscar recursos gratuitos...", "hero.title": "Recursos gratuitos. Curados diariamente.", "hero.subtitle": "Descubre los mejores recursos gratuitos — herramientas de IA, recursos de diseño, herramientas de desarrollo, cursos y más. Todo gratis, todo de alta calidad.", "sections.categories": "Categorías", "sections.trending": "Tendencia de esta semana", "sections.recent": "Añadidos recientemente", "common.resources": "recursos", noResources: "No se encontraron recursos.", "backToHome": "← Volver a inicio", "backToCategories": "← Volver a todas las categorías", noTrending: "Aún no hay recursos destacados.", noRecent: "Aún no hay recursos." },
    fr: { search: "Rechercher", "nav.home": "FreeNav", "nav.about": "À propos", "nav.categories": "Catégories", "nav.submit": "Soumettre", "nav.github": "GitHub", "footer.tagline": "Toutes les ressources sont sélectionnées et vérifiées.", "search.placeholder": "Rechercher des ressources gratuites...", "hero.title": "Ressources gratuites. Sélectionnées quotidiennement.", "hero.subtitle": "Découvrez les meilleures ressources gratuites — outils d'IA, actifs de design, outils de développement, cours et plus. Tout est gratuit, tout est de haute qualité.", "sections.categories": "Catégories", "sections.trending": "Tendance de la semaine", "sections.recent": "Ajoutés récemment", "common.resources": "ressources", noResources: "Aucune ressource trouvée.", "backToHome": "← Retour à l'accueil", "backToCategories": "← Retour à toutes les catégories", noTrending: "Aucune ressource tendance pour le moment.", noRecent: "Aucune ressource pour le moment." }
  };

  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    });
  }

  const langBtn = document.getElementById('lang-switch');
  const langDropdown = document.getElementById('lang-dropdown');
  const langContainer = document.getElementById('lang-switcher-container');

  function applyLanguage(lang) {
    // Update button flag
    const flagMap = { en: '🇺🇸', zh: '🇨🇳', ja: '🇯🇵', ko: '🇰🇷', es: '🇪🇸', fr: '🇫🇷' };
    langBtn.innerHTML = flagMap[lang] || '🇺🇸';
    // Save preference
    localStorage.setItem('freenav-lang', lang);
    // Apply translations to all elements with data-i18n attribute
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      const keys = key.split('.');
      let value = translations[lang];
      for (const k of keys) {
        if (value && typeof value === 'object' && k in value) {
          value = value[k];
        } else {
          value = null;
          break;
        }
      }
      if (value) {
        if (el.placeholder !== undefined) {
          el.placeholder = value;
        } else {
          el.textContent = value;
        }
      }
    });
  }

  if (langBtn && langDropdown) {
    // Set initial flag based on saved language
    const savedLang = localStorage.getItem('freenav-lang') || 'en';
    const flagMap = { en: '🇺🇸', zh: '🇨🇳', ja: '🇯🇵', ko: '🇰🇷', es: '🇪🇸', fr: '🇫🇷' };
    applyLanguage(savedLang);

    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      langDropdown.classList.toggle('hidden');
    });

    // Handle language selection
    const langOptions = document.querySelectorAll('.lang-option');
    langOptions.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.dataset.lang;
        applyLanguage(lang);
        langDropdown.classList.add('hidden');
        
        // Dispatch event so other components can react (e.g., homepage quick links)
        window.dispatchEvent(new CustomEvent('freenav-lang-changed', { detail: { lang } }));
        // Show toast notification
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-4 right-4 bg-surface border border-border rounded-lg px-4 py-2 shadow-lg text-sm z-50';
        toast.textContent = 'Language: ' + btn.textContent.trim();
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      });
    });

    document.addEventListener('click', (e) => {
      if (langContainer && !langContainer.contains(e.target)) {
        langDropdown.classList.add('hidden');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !langDropdown.classList.contains('hidden')) {
        langDropdown.classList.add('hidden');
      }
    });
  }
</script>