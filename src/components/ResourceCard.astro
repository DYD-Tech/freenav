---
interface Resource {
  id: string;
  slug?: string;
  title: string;
  description: string;
  url: string;
  official?: boolean;
  category?: string;
  tags?: string[];
  pricing?: string;
  logo?: string;
  dateAdded?: string;
  addedAt?: string;
  rating?: number;
  featured?: boolean;
}

interface Props {
  resource: Resource;
  className?: string;
}
---

<a
  href={`${import.meta.env.BASE_URL || ''}/resource/${Astro.props.resource.slug || Astro.props.resource.id}`}
  class:list={[
    'block group transition-all',
    Astro.props.className
  ]}
>
  <div class="rounded-xl border border-border bg-surface p-4 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md">
    <div class="flex items-start gap-3">
      {Astro.props.resource.logo && (
        <img
          src={Astro.props.resource.logo}
          alt={Astro.props.resource.title}
          class="w-10 h-10 rounded-lg object-contain"
          loading="lazy"
          width={40}
          height={40}
        />
      )}
      {!Astro.props.resource.logo && (
        <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center text-lg">
          📦
        </div>
      )}
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <h3 class="font-semibold text-sm text-foreground group-hover:text-primary-600 dark:group-hover:text-primary-400">
            {Astro.props.resource.title}
          </h3>
          {Astro.props.resource.official && (
            <span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-1.5 py-0.25 rounded">
              Official
            </span>
          )}
          {Astro.props.resource.pricing === 'free' && (
            <span class="text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 px-1.5 py-0.25 rounded">
              Free
            </span>
          )}
        </div>
        <p class="text-sm text-muted-foreground line-clamp-2">
          {Astro.props.resource.description}
        </p>
        {Astro.props.resource.tags && (
          <div class="flex items-center gap-1 mt-2 flex-wrap">
            {Astro.props.resource.tags.slice(0, 3).map((tag) => (
              <span class="text-xs px-2 py-0.5 bg-muted rounded-full">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</a>