---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/categories';
import { quickLinks, defaultLinks } from '../data/quick-links';
import resourcesData from '../data/resources.json';

const resources = Array.isArray(resourcesData) ? resourcesData : (resourcesData.resources || []);
const baseURL = '/freenav';

const categoryCounts = {};
for (const r of resources) {
  categoryCounts[r.category] = (categoryCounts[r.category] || 0) + 1;
}

const recent = resources
  .sort((a, b) => new Date(b.dateAdded || b.addedAt || 0) - new Date(a.dateAdded || a.addedAt || 0))
  .slice(0, 6);
---
<BaseLayout title="FreeNav — Free Resource Hub">
  <Navbar />

  <main class="flex-1">
    <!-- Layer 1: Full-Screen Navigation Homepage -->
    <section class="h-screen flex items-center justify-center">
      <div class="container mx-auto px-4 text-center">
        <div class="mb-8">
          <h1 class="text-2xl md:text-3xl font-bold mb-2">FreeNav</h1>
          <p class="text-sm text-muted-foreground">Free resources • Browser homepage</p>
        </div>

        <!-- Web Search -->
        <div class="max-w-xl mx-auto mb-10">
          <form id="homepage-search" class="flex gap-2">
            <div class="relative flex-1">
              <input
                type="search"
                id="homepage-search-input"
                placeholder="Search the web..."
                class="w-full pl-12 pr-4 py-3 text-sm rounded-xl border border-border bg-surface focus:outline-none focus:ring-2 focus:ring-primary-500"
              />
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
            </div>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">
              Search
            </button>
          </form>
        </div>

        <!-- Language-Specific Quick Links Grid -->
        <div id="quick-links-grid" class="max-w-4xl mx-auto">
          <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-4">
            {defaultLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center text-center p-3 rounded-xl border border-border bg-surface hover:shadow-md transition-all"
                title={link.name}
                data-quicklink="en"
              >
                <div class="w-12 h-12 flex items-center justify-center text-2xl mb-1">{link.icon}</div>
                <span class="text-xs font-medium text-foreground group-hover:text-primary-600">{link.name}</span>
              </a>
            ))}

            {Object.entries(quickLinks).filter(([lang]) => lang !== 'en').map(([lang, links]) =>
              links.map((link) => (
                <a
                  key={`${lang}-${link.url}`}
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col items-center text-center p-3 rounded-xl border border-border bg-surface hover:shadow-md transition-all hidden"
                  title={link.name}
                  data-quicklink={lang}
                >
                  <div class="w-12 h-12 flex items-center justify-center text-2xl mb-1">{link.icon}</div>
                  <span class="text-xs font-medium text-foreground group-hover:text-primary-600">{link.name}</span>
                </a>
              ))
            )}
          </div>
        </div>

        <!-- Scroll Hint -->
        <div class="mt-10 animate-bounce">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-muted-foreground">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="19" y1="12" x2="12" y2="19" />
            <line x1="5" y1="12" x2="12" y2="19" />
          </svg>
          <p class="text-xs text-muted-foreground mt-2">Scroll for more</p>
        </div>
      </div>
    </section>

    <!-- Layer 2: Resources Directory (Below the Fold) -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <div class="mb-12">
          <h2 class="text-2xl font-semibold mb-6">Categories</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-7 gap-4">
            {categories.map((cat) => (
              <a href={`${baseURL}/category/${cat.slug}`} class="group flex flex-col items-center text-center p-4 rounded-xl border border-border bg-surface hover:shadow-md transition-all">
                <span class="text-3xl mb-2">{cat.icon}</span>
                <span class="font-medium text-sm group-hover:text-primary-600">{cat.name}</span>
                <span class="text-xs text-muted-foreground mt-1">{categoryCounts[cat.slug] || 0} resources</span>
              </a>
            ))}
          </div>
        </div>

        {recent.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-semibold mb-6">Recently Added</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {recent.map((resource) => (
                <a href={resource.url} target="_blank" rel="noopener noreferrer" class="block group transition-all">
                  <div class="rounded-xl border border-border bg-surface p-4 hover:shadow-md">
                    <div class="flex items-start gap-3">
                      <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center text-lg">📦</div>
                      <div class="flex-1 min-w-0">
                        <h3 class="font-semibold text-sm text-foreground group-hover:text-primary-600">{resource.title}</h3>
                        <p class="text-sm text-muted-foreground line-clamp-2">{resource.description}</p>
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('homepage-search');
    const input = document.getElementById('homepage-search-input');

    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = input.value.trim();
        if (!query) return;
        window.open('https://www.google.com/search?q=' + encodeURIComponent(query), '_blank');
        input.value = '';
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); form.dispatchEvent(new Event('submit')); }
      });
    }

    // Language-specific quick links
    const allLinks = document.querySelectorAll('[data-quicklink]');
    const savedLang = localStorage.getItem('freenav-lang') || 'en';
    allLinks.forEach(link => {
      link.classList.toggle('hidden', link.getAttribute('data-quicklink') !== savedLang);
    });
    window.addEventListener('freenav-lang-changed', (e) => {
      allLinks.forEach(link => {
        link.classList.toggle('hidden', link.getAttribute('data-quicklink') !== e.detail.lang);
      });
    });
  </script>
</BaseLayout>