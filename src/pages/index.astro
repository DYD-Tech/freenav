---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { categories } from '../data/categories';
import resourcesData from '../data/resources.json';

const resources = Array.isArray(resourcesData) ? resourcesData : (resourcesData.resources || []);
const baseURL = '/freenav';

// Get all resources as direct quick links
const quickLinks = resources.map(r => ({
  id: r.id || r.slug,
  title: r.title,
  url: r.url,
  category: r.category,
  icon: r.logo || '🔗',
  pricing: r.pricing,
  official: r.official
}));

// Group by category
const categoryMap = {};
categories.forEach(cat => {
  categoryMap[cat.slug] = { ...cat, items: [] };
});

quickLinks.forEach(link => {
  const catSlug = link.category;
  if (categoryMap[catSlug]) {
    categoryMap[catSlug].items.push(link);
  } else {
    // Create uncategorized bucket
    if (!categoryMap['uncategorized']) {
      categoryMap['uncategorized'] = { id: 'uncategorized', name: 'Other', slug: 'uncategorized', icon: '📦', items: [] };
    }
    categoryMap['uncategorized'].items.push(link);
  }
});

const navCategories = Object.values(categoryMap).filter(c => c.items.length > 0);
---
<BaseLayout title="FreeNav — Free Resource Hub">
  <Navbar />

  <main class="min-h-screen flex items-center justify-center">
    <div class="container mx-auto px-4 text-center py-12">
      <!-- Logo + Tagline -->
      <div class="mb-10">
        <h1 class="text-2xl md:text-3xl font-bold mb-2">
          FreeNav
        </h1>
        <p class="text-sm text-muted-foreground">
          Free resources • Browser homepage
        </p>
      </div>

      <!-- Search (opens new tab to Google) -->
      <div class="max-w-2xl mx-auto mb-10">
        <form id="homepage-search" class="flex gap-2">
          <div class="relative flex-1">
            <input
              type="search"
              id="homepage-search-input"
              placeholder="Search the web..."
              class="w-full pl-12 pr-4 py-3 text-sm rounded-xl border border-border bg-surface focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              autocomplete="off"
            />
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground"
            >
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <button
            type="submit"
            class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 focus:outline-none"
          >
            Search
          </button>
        </form>
      </div>

      <!-- Direct Resource Links Grid -->
      <div class="max-w-5xl mx-auto">
        {navCategories.map((cat) => (
          <div class="mb-10" key={cat.slug}>
            <h2 class="text-lg font-semibold mb-4 flex items-center justify-center gap-2">
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </h2>
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3">
              {cat.items.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col items-center text-center p-3 rounded-xl border border-border bg-surface hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all hover:-translate-y-0.5"
                  title={item.title}
                >
                  <div class="w-12 h-12 flex items-center justify-center text-2xl mb-1 bg-muted/30 rounded-lg overflow-hidden">
                    {item.icon && item.icon.startsWith('http') ? (
                      <img src={item.icon} alt={item.title} class="w-full h-full object-contain" />
                    ) : (
                      <span>{item.icon}</span>
                    )}
                  </div>
                  <span class="text-xs font-medium text-foreground group-hover:text-primary-600 dark:group-hover:text-primary-400 line-clamp-1">
                    {item.title}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <!-- Minimal Footer -->
  <footer class="border-t border-border py-4 text-center text-xs text-muted-foreground">
    <span>© {new Date().getFullYear()} FreeNav</span>
    <a href="/freenav/about" class="hover:text-foreground">About</a>
    <a href="/freenav/search" class="hover:text-foreground">Search</a>
  </footer>

  <script>
    // Homepage search → opens Google search in new tab
    const form = document.getElementById('homepage-search');
    const input = document.getElementById('homepage-search-input');

    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = input.value.trim();
        if (!query) return;
        window.open('https://www.google.com/search?q=' + encodeURIComponent(query), '_blank');
        input.value = '';
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          form.dispatchEvent(new Event('submit'));
        }
      });
    }
  </script>
</BaseLayout>