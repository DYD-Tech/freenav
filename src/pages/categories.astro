---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/categories';
import resourcesData from '../data/resources.json';

const resources = Array.isArray(resourcesData) ? resourcesData : (resourcesData.resources || []);

const categoryCounts = {};
for (const r of resources) {
  categoryCounts[r.category] = (categoryCounts[r.category] || 0) + 1;
}
---
<BaseLayout title="Categories — Free Resources | FreeNav">
  <Navbar />

  <section class="py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-4">All Categories</h1>
      <p class="text-muted-foreground mb-8">
        Browse free resources organized by category
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
        {categories.map((cat) => (
          <a
            href={`/freenav/category/${cat.slug}`}
            class="group flex flex-col items-center text-center p-6 rounded-xl border border-border bg-surface hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all"
          >
            <span class="text-4xl mb-3">{cat.icon}</span>
            <h2 class="font-semibold text-lg group-hover:text-primary-600 dark:group-hover:text-primary-400">
              {cat.name}
            </h2>
            <p class="text-xs text-muted-foreground mt-1">
              {categoryCounts[cat.slug] || 0} resources
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
